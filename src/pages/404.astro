---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not found — The Pigeon Institute">
  <section class="not-found shell">
    <span class="eyebrow">404 / Navigation variance</span>
    <h1>This route has<br />left the flock.</h1>
    <p>The requested location is not currently part of the urban flight plan.</p>
    <a class="text-link" href="/">Return home →</a>
  </section>
</BaseLayout>

<style>
  .not-found { min-height: 85svh; display: flex; flex-direction: column; justify-content: center; padding-top: 100px; }
  .not-found h1 { margin: 45px 0 28px; font-size: clamp(4rem, 10vw, 10rem); font-weight: 420; line-height: .86; letter-spacing: -.07em; }
  .not-found p { color: #888; font-size: 1.15rem; }
</style>
