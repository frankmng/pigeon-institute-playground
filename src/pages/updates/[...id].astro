---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate } from '../../lib';

export async function getStaticPaths() {
  const updates = await getCollection('updates');
  return updates.map((update) => ({ params: { id: update.id }, props: { update } }));
}

const { update } = Astro.props as { update: CollectionEntry<'updates'> };
const { Content } = await render(update);
---

<BaseLayout title={`${update.data.title} — The Pigeon Institute`} description={update.data.summary} current="updates" image={update.data.heroImage}>
  <article>
    <header class="article-header shell">
      <a class="back" href="/updates/">← All updates</a>
      <div class="article-meta">
        <span>{update.data.category}</span>
        <time datetime={update.data.date.toISOString()}>{formatDate(update.data.date)}</time>
      </div>
      <h1>{update.data.title}</h1>
      <p>{update.data.summary}</p>
    </header>
    <figure class="article-hero shell">
      <img src={update.data.heroImage} alt="" />
    </figure>
    <div class="article-body shell">
      <div class="article-rail">
        <span class="eyebrow">Institute update</span>
        <span>Filed {formatDate(update.data.date)}</span>
      </div>
      <div class="prose"><Content /></div>
    </div>
    {update.data.gallery.length > 0 && (
      <div class="gallery shell">
        {update.data.gallery.map((image) => <img src={image} alt="Additional field documentation" loading="lazy" />)}
      </div>
    )}
    <div class="article-end shell"><a href="/updates/">← Return to all updates</a></div>
  </article>
</BaseLayout>

<style>
  .article-header { padding-top: 170px; text-align: center; }
  .back { display: inline-block; margin-bottom: 70px; color: #888; font-size: .75rem; text-transform: uppercase; letter-spacing: .12em; }
  .article-meta { display: flex; justify-content: center; gap: 30px; color: #999; font-size: .72rem; text-transform: uppercase; letter-spacing: .14em; }
  .article-header h1 { max-width: 1150px; margin: 40px auto 30px; font-size: clamp(3.5rem, 8vw, 8.5rem); font-weight: 430; line-height: .9; letter-spacing: -.07em; }
  .article-header > p { max-width: 710px; margin: 0 auto 80px; color: #aaa; font-size: clamp(1.1rem, 2vw, 1.5rem); line-height: 1.5; }
  .article-hero { margin-bottom: 110px; }
  .article-hero img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; }
  .article-body { display: grid; grid-template-columns: 1fr 2fr; gap: 8vw; padding-bottom: 120px; }
  .article-rail { display: flex; flex-direction: column; gap: 22px; color: #777; font-size: .72rem; text-transform: uppercase; letter-spacing: .13em; }
  .prose { max-width: 760px; }
  .prose :global(p) { margin: 0 0 1.6em; color: #c2c2bd; font-family: Georgia, 'Times New Roman', serif; font-size: clamp(1.15rem, 2vw, 1.4rem); line-height: 1.8; }
  .prose :global(h2) { margin: 2.2em 0 .8em; font-size: clamp(2rem, 4vw, 3.8rem); font-weight: 440; letter-spacing: -.05em; line-height: 1; }
  .prose :global(blockquote) { margin: 2.5em 0; padding-left: 30px; border-left: 1px solid #777; color: white; }
  .prose :global(blockquote p) { font-family: inherit; font-size: clamp(1.5rem, 3vw, 2.6rem); line-height: 1.25; }
  .prose :global(img) { margin: 3em 0; width: 100%; }
  .gallery { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; padding-bottom: 100px; }
  .gallery img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .article-end { padding: 55px 0 130px; border-top: 1px solid var(--line); text-transform: uppercase; font-size: .75rem; letter-spacing: .13em; }
  @media (max-width: 760px) {
    .article-header { padding-top: 140px; }
    .back { margin-bottom: 50px; }
    .article-header > p { margin-bottom: 55px; }
    .article-hero { width: 100%; margin-bottom: 70px; }
    .article-body { grid-template-columns: 1fr; padding-bottom: 70px; }
    .article-rail { padding-bottom: 30px; border-bottom: 1px solid var(--line); }
    .gallery { grid-template-columns: 1fr; }
  }
</style>
